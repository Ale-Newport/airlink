# AirLink has no server, no API keys and no runtime secrets: nothing in the app
# reads an environment variable. These are only for the build scripts on your
# own machine. Copy to .env (git-ignored) and load it into your shell with:
#
#   set -a; source .env; set +a
#
# Never commit a real .env.

# Your Apple Developer Team ID (10 characters, e.g. ABCDE12345), used by
# scripts/run-device.sh and scripts/archive-ios.sh to sign builds. Optional:
# both scripts also take --team, and will find your team from Xcode if unset.
AIRLINK_TEAM_ID=

# Android builds (see docs/ANDROID.md).
# JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
# ANDROID_HOME=$HOME/Library/Android/sdk
